{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/*.min.js",
      "!src/scripts/jxa/_types/**"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useNamingConvention": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "http": "Network access is forbidden (DESIGN §18).",
              "https": "Network access is forbidden (DESIGN §18).",
              "node:http": "Network access is forbidden (DESIGN §18).",
              "node:https": "Network access is forbidden (DESIGN §18).",
              "node-fetch": "Network access is forbidden — use JXA/OmniJS transport.",
              "axios": "Network access is forbidden — use JXA/OmniJS transport.",
              "undici": "Network access is forbidden — use JXA/OmniJS transport.",
              "cross-fetch": "Network access is forbidden — use JXA/OmniJS transport."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "nursery": {}
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/**/*.ts", "**/scripts/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/webhooks/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/scripts/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/tests/**/*.ts", "**/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
