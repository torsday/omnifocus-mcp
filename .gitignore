node_modules/
*.log
.DS_Store
.env
.env.local
.idea/

# Development tooling — editor and AI assistant configs are personal
.vscode/
.claude/

# Project board constants contain personal GitHub project IDs.
# Copy scripts/_project-constants.sh.example → scripts/_project-constants.sh
# and fill in your own values.
scripts/_project-constants.sh

dist/

# Compiled Swift watcher binary — generated by `pnpm build:watcher`.
# Source lives in tools/watcher/omnifocus-watcher.swift.
# Binaries are distributed via npm optional packages in CI.
bin/omnifocus-watcher
bin/omnifocus-watcher-darwin-arm64
bin/omnifocus-watcher-darwin-x64

# Compiled Swift calendar bridge binary — generated by `pnpm build:calendar-bridge`.
# Source lives in tools/calendar-bridge/calendar-bridge.swift (per ADR-0018).
bin/calendar-bridge
bin/calendar-bridge-darwin-arm64
bin/calendar-bridge-darwin-x64

# Stryker mutation testing artifacts (per ADR-0017).
# Reports are uploaded as release artifacts; the temp dir is sandbox state.
.stryker-tmp/
reports/mutation/
stryker.log
