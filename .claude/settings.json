{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm exec *)",
      "Bash(pnpm biome *)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // .tool_input.path // empty' 2>/dev/null); if [[ \"$file\" == *.ts || \"$file\" == *.js ]]; then pnpm biome check --write \"$file\" 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  }
}
